<?xml version="1.0" encoding="utf-8" ?>
<otobo_package version="1.0">
    <Name>Webservice-CustomerOperations</Name>
    <Version>0.0.0</Version>
    <Framework>11.1.x</Framework>
    <Vendor>Perl-Services.de</Vendor>
    <URL>http://www.perl-services.de</URL>
    <License>GNU AFFERO GENERAL PUBLIC LICENSE Version 3, November 2007</License>
    <Description Lang="de">Verbesserungen am GenericInterface</Description>
    <Description Lang="en">Enhancements for the GenericInterface</Description>
    <Filelist>
        <File Permission="660" Location="Kernel/GenericInterface/Operation/Customer/Common.pm" />
        <File Permission="660" Location="Kernel/GenericInterface/Operation/Customer/CustomerUpsert.pm" />
        <File Permission="660" Location="Kernel/GenericInterface/Operation/Customer/CustomerUserUpsert.pm" />
        <File Permission="660" Location="Kernel/Config/Files/XML/WebserviceCustomerOperations.xml" />
        <File Permission="660" Location="var/GenericInterface/CRM.yml" />
        <File Permission="660" Location="var/packagesetup/WebserviceCustomerOperations.pm" />
    </Filelist>
    <CodeInstall Type="post"><![CDATA[
        $Kernel::OM->Get('var::packagesetup::WebserviceCustomerOperations')->CodeInstall();
    ]]></CodeInstall>
    <CodeUpgrade Type="post"><![CDATA[
        $Kernel::OM->Get('var::packagesetup::WebserviceCustomerOperations')->CodeUpgrade();
    ]]></CodeUpgrade>
    <CodeUninstall Type="pre"><![CDATA[
        $Kernel::OM->Get('var::packagesetup::WebserviceCustomerOperations')->CodeUninstall();
    ]]></CodeUninstall>
</otobo_package>
